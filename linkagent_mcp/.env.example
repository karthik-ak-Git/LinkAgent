# LinkAgent MCP — Environment Configuration
# Copy this file to .env and adjust as needed.

# CDP connection (browser must be started with --remote-debugging-port)
LINKAGENT_CDP_PORT=9222
LINKAGENT_CDP_HOST=127.0.0.1

# Logging
LINKAGENT_LOG_LEVEL=INFO
# LINKAGENT_LOG_FILE=linkagent.log

# Screenshot output directory
# LINKAGENT_SCREENSHOT_DIR=./screenshots

# MCP server name (used in protocol)
# LINKAGENT_SERVER_NAME=linkagent

# --- Docker ---
# When running in Docker, set CDP_HOST to the container's hostname
# LINKAGENT_CDP_HOST=127.0.0.1
